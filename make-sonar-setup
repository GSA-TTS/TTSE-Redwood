#!/usr/bin/env bash
set -euo pipefail

if command -v sonar-scanner >/dev/null 2>&1; then
  echo "sonar-scanner already installed: $(sonar-scanner --version | head -n 1)"
  exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed. Install Homebrew first, then rerun make sonar-setup." >&2
  exit 1
fi

echo "Installing sonar-scanner with Homebrew..."
brew install sonar-scanner

echo "sonar-scanner installed successfully."
sonar-scanner --version | head -n 1
